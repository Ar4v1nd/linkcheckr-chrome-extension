{
  "manifest_version": 3,
  "name": "LinkCheckr",
  "version": "1.0.0",
  "description": "Checks visible links on any webpage and flags broken ones with a red ❌ icon.",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ],
  "action": {
    "default_icon": "icons/icon_48.png",
    "default_title": "LinkCheckr"
  }
}
